@echo off
:: ============================================================================
:: Файл: start.bat — установка и запуск SkillSwap на своём компьютере (Windows).
:: Что делает:
::   1) проверяет, установлен ли Node.js (без него не запустить локальный сервер);
::      если нет — предлагает установить его через winget или открывает nodejs.org;
::   2) устанавливает зависимости проекта (npm install, список — в package.json);
::   3) запускает локальный сервер и открывает сайт в браузере.
:: Как запустить: двойной щелчок по файлу. Остановить сервер: закрыть окно.
:: Как связан с остальными: запускает скрипт "start" из package.json.
:: ============================================================================

:: chcp 65001 — кодировка UTF-8, чтобы русские буквы в окне выглядели правильно; >nul — не печатать ответ команды
chcp 65001 >nul
:: title — заголовок окна
title SkillSwap
:: cd /d "%~dp0" — перейти в папку, где лежит этот файл (%~dp0 — путь к ней; /d — сменить и диск)
cd /d "%~dp0"

:: echo. — пустая строка
echo.
:: заголовок
echo  === SkillSwap: подготовка к запуску ===
:: пустая строка
echo.

:: where node — ищем программу node; 2>nul — прячем ошибки; || — если НЕ нашли, переходим к метке install_node
where node >nul 2>nul || goto install_node
:: нашли — переходим дальше
goto node_ok

:: ---------------------------------------------------------------------------
:: Node.js не найден
:: ---------------------------------------------------------------------------
:install_node
:: сообщение
echo  [!] Node.js не найден. Он нужен, чтобы запустить сайт на компьютере.
:: winget — встроенный в Windows 10/11 установщик программ; если его нет — ставим вручную
where winget >nul 2>nul || goto manual_node
:: сообщение
echo  Устанавливаю Node.js LTS через winget (Windows может попросить подтверждение)...
:: --id OpenJS.NodeJS.LTS — официальный пакет Node.js; -e — точное совпадение имени
winget install --id OpenJS.NodeJS.LTS -e
:: пустая строка
echo.
:: новая программа станет видна только в НОВОМ окне, поэтому просим запустить файл ещё раз
echo  Готово. Закрой это окно и запусти start.bat ещё раз.
:: pause — ждём нажатия любой клавиши, чтобы окно не закрылось сразу
pause
:: exit /b — выйти из батника
exit /b

:: ---------------------------------------------------------------------------
:: winget нет — ставим Node.js вручную
:: ---------------------------------------------------------------------------
:manual_node
:: сообщение
echo  Скачай и установи Node.js LTS с официального сайта, затем запусти start.bat ещё раз.
:: start "" адрес — открыть страницу в браузере по умолчанию
start "" https://nodejs.org/
:: ждём клавишу
pause
:: выход с кодом 1 (ошибка)
exit /b 1

:: ---------------------------------------------------------------------------
:: Node.js есть — устанавливаем зависимости и запускаем
:: ---------------------------------------------------------------------------
:node_ok
:: for /f ... in ('node -v') — выполнить node -v и напечатать версию
for /f "delims=" %%v in ('node -v') do echo  [ok] Node.js %%v
:: пустая строка
echo.
:: сообщение
echo  Устанавливаю зависимости (npm install)...
:: call — вызвать npm и вернуться в батник; --no-fund --no-audit — без лишних сообщений; || — при ошибке к метке npm_error
call npm install --no-fund --no-audit || goto npm_error
:: пустая строка
echo.
:: сообщение
echo  [ok] Всё установлено.
:: адрес сайта
echo  Сайт откроется в браузере: http://localhost:5500
:: как остановить
echo  Чтобы остановить сервер, закрой это окно.
:: пустая строка
echo.
:: npm start — скрипт "start" из package.json (сервер http-server на порту 5500); -- -o — передать серверу флаг -o: открыть браузер, когда сервер готов
call npm start -- -o
:: если сервер остановился — ждём клавишу, чтобы было видно сообщение
pause
:: выход
exit /b

:: ---------------------------------------------------------------------------
:: ошибка установки зависимостей
:: ---------------------------------------------------------------------------
:npm_error
:: сообщение
echo  [x] Не удалось установить зависимости. Проверь интернет и запусти start.bat ещё раз.
:: ждём клавишу
pause
:: выход с ошибкой
exit /b 1
